POSTGRES_DB=dbagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5656
DB_AGENT_DATABASE_URL=
DB_AGENT_DATABASE_HOST=
DB_AGENT_DATABASE_PORT=
DB_AGENT_DATABASE_NAME=
DB_AGENT_DATABASE_USER=dbagent_reader
DB_AGENT_DATABASE_PASSWORD=
# JSON list for databases on the same PostgreSQL server, for example:
# DATABASES_AVAILABLE=["commerce","support"]
DATABASES_AVAILABLE=

# Disable this if your database is not read-only, and you would even risk the 0.001% chance of data corruption.
DB_AGENT_ENFORCE_READONLY_ROLE=true

DB_AGENT_ALLOWED_SCHEMAS=public
DB_AGENT_ALLOWED_TABLES=
DB_AGENT_MAX_ROWS=200
DB_AGENT_MAX_RESULT_CHARS=50000
DB_AGENT_STATEMENT_TIMEOUT_MS=10000
DB_AGENT_MAX_TOOL_CALLS=5
DB_AGENT_QUERY_RETRIES=2
DB_AGENT_MODEL_MAX_TOKENS=4096
DB_AGENT_ENABLE_THINKING=true
DB_AGENT_PROFILE=sales
DB_AGENT_SCHEMA_CACHE_TTL_SECONDS=300
DB_AGENT_MAX_DATABASE_CONCURRENCY=4
DB_AGENT_MAX_INTERMEDIATE_ROWS=10000
DB_AGENT_MAX_FEDERATED_BYTES=50000000

LLM_HOST_MODEL_PATH=/absolute/path/to/your/llm/model
LLM_CONTAINER_MODEL_PATH=/models/llm
LLM_MODEL_NAME=your-model-name
LLM_API_MODE=chat
LLM_DTYPE=bfloat16
LLM_GPU_MEMORY_UTILIZATION=0.6
LLM_ENABLE_AUTO_TOOL_CHOICE=false
LLM_TOOL_CALL_PARSER=
# LLM_API_BASE_URL=http://192.168.1.50:8000/v1
LLM_TENSOR_PARALLEL_SIZE=1
LLM_API_KEY=EMPTY
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_GPU_DEVICE_ID=0

# These parameters are the ones used by the agentic interface
LLM_HOST=127.0.0.1
LLM_PORT=8000
